# Production rules for Apache / LiteSpeed (shared hosting). SvelteKit copies this file into
# the build, so it ends up in the web root next to index.html.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # HTTPS only (except a local test copy)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # The API and certificate checks have their own handling
    RewriteRule ^(api|\.well-known)(/|$) - [L]

    # Real files are served as they are; any other path is a page of the app
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]
    RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
    # Browsers ignore this over plain HTTP, so it only takes effect once HTTPS works
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # No framing (clickjacking), no plugins. Scripts aren't restricted: the app's boot script is inline.
    Header always set Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"

    # The page must always be fresh so a new release is picked up; built files have hashed names
    <Files "index.html">
        Header set Cache-Control "no-cache"
    </Files>
</IfModule>
