# Route every request to index.php. Nothing else in this folder (.env, vendor/, scripts/,
# migrations/, tests/) is ever served or executed directly.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^index\.php$ - [L]
    RewriteRule ^ index.php [L,QSA]
</IfModule>

# Without mod_rewrite, refuse everything rather than expose files
<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
