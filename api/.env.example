# Copy to .env and adjust. Settings not listed here use the defaults in core/Environment.php.

DB_HOST=localhost
DB_NAME=clairvoyance_v3
DB_USER=root
DB_PASS=

# Where people open the app. Used in emailed links; https:// also marks the session cookie Secure.
APP_URL=http://localhost:5173

# Other origins allowed to call the API with cookies (comma-separated). In production the app
# and the API share one origin, so leave this empty there.
ALLOWED_ORIGINS=http://localhost:5173

# Email (SMTP). Leave MAIL_HOST empty to send nothing: invitations are then links to copy,
# and password resets need scripts/reset_password.php.
#   Hosting mailbox:   MAIL_HOST=smtp.hostinger.com  MAIL_PORT=465  MAIL_ENCRYPTION=ssl
#   Brevo:             MAIL_HOST=smtp-relay.brevo.com  MAIL_PORT=587  MAIL_ENCRYPTION=tls
#   Mailpit (local):   MAIL_HOST=127.0.0.1  MAIL_PORT=1025  MAIL_ENCRYPTION=none
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Clairvoyance
